# Copy to .env.local and fill in. Never commit real keys.

# ── Supabase ─────────────────────────────────────────────
# Local: `npm run db:start` prints these (API URL, anon key, service_role key).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used to create orders, confirm payments and store contact messages.
SUPABASE_SERVICE_ROLE_KEY=

# ── Site ─────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3020

# ── Paymob (Accept) ──────────────────────────────────────
PAYMOB_API_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_INTEGRATION_ID_WALLET=
PAYMOB_IFRAME_ID=
# Local development only: "1" replaces Paymob with a test panel when the keys
# above are empty. Ignored in production builds.
PAYMOB_MOCK=1
